.venv/
**/__pycache__/
.vscode/
chrome/
logs/
.DS_Store
usersData.json
.env
# python-dotenv 的 set_key() 是"写临时文件 → os.replace()"，中间态里是**完整的 .env**
# （含全部 COOKIES_），进程在两步之间被杀掉就会留在仓库里。
# ⚠️ 临时文件的真实名字是 `.tmp_xxxxxxxx`（不是 `.env.tmp_xxx`）：
#    `tempfile.NamedTemporaryFile(prefix=".tmp_", dir=<.env 所在目录>)`，实测
#    python-dotenv 1.2.4（requirements 钉的是 1.2.2）。两套名字都列上防御，
#    因为 `.env` 这条规则匹配不到它们（gitignore 没有前缀语义）—— 否则会被
#    git add -A / rsync / 打包一起带走。
.env.tmp_*
.tmp_*

# 抓包取证目录：HAR 本身含 cookie（登录凭据）+ 好友昵称/备注/uid，
# 同目录 <sha1>.dat 是配套的二进制报文体，_*.txt 是分析产物 —— 全都含个人信息。
# 一律不入库（"har 不提交"）。需要复现就在本机跑 tools/record_har.py 重录。
har_logs/

# 账户登录态的浏览器配置目录：体积大且含敏感登录信息，绝不入库
configTool/profiles/

# 抖音号 -> 配置目录 对照表（含昵称 / uid 等账号信息），不入库
configTool/profiles.json
configTool/cloakbrowser-windows-x64/
# 分发包本体（约 536 MB）同理，不入库
configTool/cloakbrowser-windows-x64.zip

# PyInstaller 打包产物
build/
dist/
*.spec

# 工作目录（本地笔记与临时脚本）
.workbuddy/

# gost 隧道客户端
configTool/gost/

# 工具自己的本地设置（local.json）：里面存着配套代理的隧道地址与账号密码，
# 入库等于把代理凭据交出去 —— 绝不提交。
configTool/local.json

# Playwright 的 API 调试日志（`DEBUG=pw:api` 重定向出来的，排查「卡很久」用）：
# 里面是完整的请求 URL 与页面跳转序列，含 token、好友昵称等个人信息，
# 与 har_logs/ 同一性质 —— 只在本机留，不入库。
pw_api.log
pw_*.log
.env.bak-*
# webui/envfile.py 的跨进程写锁（`<env>.lock`）：空文件，运行时生成，别入库。
.env.lock
