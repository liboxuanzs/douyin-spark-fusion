# DouYinSparkFlow .env 示例
#
# 使用方法：
# 1. 本地运行：复制本文件为项目根目录 .env
# 2. Docker 运行：将本文件保存到宿主机某个路径，默认路径为 ./config/.env
# 3. 按说明替换下面的示例值
# 4. 运行 python main.py 或 docker compose up -d --build
#
# 注意：
# - TASKS 和 COOKIES_<unique_id> 是必填项
# - 所有 JSON 必须保持为单行，不能写成多行
# - COOKIES_<unique_id> 的 unique_id 后缀必须与 TASKS 中该账号的 unique_id 完全一致
# - Docker 默认将 ./config/.env 挂载为容器内 /app/.env，并将 ./logs 挂载到容器 /app/logs
# - 如需修改宿主机配置文件路径，可在启动前设置 CONFIG_ENV_FILE
# - 如需修改宿主机日志目录，可在启动前设置 LOGS_DIR
# - 面板「运行配置」可以直接改本文件里的运行参数（白名单见 webui/settings.py）；
#   只写它管的那些键，注释、变量顺序、TASKS 与 COOKIES_* 一个字节都不动，写前自动备份

# 可选：代理地址
# 任务运行时用它作为浏览器出口（core/browser.py:165 传给浏览器；扫码登录 core/qr_login.py:241、
# 好友扫描 core/friend_scan.py:199 也读同一项）。留空 = 直连。
# 面板「运行配置」里也能改这一项（口令部分只会显示成 ***，不动它就不会被覆盖）。
PROXY_ADDRESS=

# Docker 部署时，配套代理（gost 容器）的隧道账号密码
# 供本地 configTool 抓 Cookie 时借道，保证抓 Cookie 的出口 IP 与任务运行一致
# 必填：不设（留空）则 docker compose 无法启动（见 docker-compose.yml 的 :? 校验）
# GOST_PASSWORD 请自己生成足够长的随机串，不要用弱密码
GOST_USER=
GOST_PASSWORD=

# Docker 定时执行配置，使用Docker部署必填
# ⚠️ 容器里默认是**每 5 分钟敲一次门**（对齐 core/schedule.py 的 TICK_MINUTES 与
#    deploy/douyin-spark-fusion-daily.timer 的 OnCalendar=*:0/5）：几点发由应用按
#    各账号 TASKS[].time 加一个抖动自己决定，敲一次门只能发"那一刻已经到点"的账号。
#    间隔可以用 CRON_TICK_MINUTES 改（1-59，写在容器环境变量或本文件里都行）。
#    下面两行是**兼容用**：把 CRON_HOUR/CRON_MINUTE 改成非 9:0 的值，容器才会退回
#    "一天只敲一次"的老行为 —— 那时抖动窗口里没到点的账号当天就发不出去（只有约
#    1/16 的账号恰好落在那一分钟里）。
# 运行时间，分别拆成时、分、秒
CRON_HOUR=9
CRON_MINUTE=0
# 只在上面那个"一天敲一次"的老行为下有意义：敲门后第 N 秒才真正开跑
CRON_SECOND=0

# Docker 容器时区，可选
TZ=Asia/Shanghai

# 可选：发送消息模板
# - 使用 \n 表示换行（**字面两个字符**：反斜杠 + n；直接敲回车会把本行拆断）
# - [API] 会替换为一言内容
# - 本文件由程序自己读（python-dotenv，文件优先）；unit 里**故意不写** systemd 的
#   EnvironmentFile= —— 它按转义序列解析值，会把上面的 \n 吃成裸 n，换行就没了
MESSAGE_TEMPLATE=[盖瑞]今日火花[加一]\n—— [右边] 每日一言 [左边] ——\n[API]

# 可选：一言类型，JSON 数组
# 可选值示例：动画、漫画、游戏、文学、原创、来自网络、影视、诗词、哲学、抖机灵、其他
HITOKOTO_TYPES=["文学","影视","诗词","哲学"]

# 可选：单次浏览器操作/导航的最长等待时间，单位秒
# 对应 Playwright 的 set_default_timeout / set_default_navigation_timeout
BROWSER_ACTION_TIMEOUT=120

# ===== 抖音 IM 扫描（core/douyin_im.py，单位统一为秒）=====

# 可选：整个扫描过程的时间总预算，单位秒
# 超时即停止滚动；此时 scanned_all=False，"未找到"不代表"不存在"
IM_SCAN_TIMEOUT=120

# 可选：门禁等待上限（登录校验 + 会话列表就绪），单位秒
IM_READY_TIMEOUT=120

# 可选：好友资料静默窗，单位秒（整数）
# 发现新会话后，等这么久没有新资料才算落定，然后继续滚动
# 调大会明显拖慢扫描（每发现一批新会话都要等一轮）
FRIEND_LIST_WAIT_TIME=3

# 可选：滚动步数硬上限（步长 = 可视高度 40%）
IM_MAX_STEPS=200

# 可选：每个目标没拿到可信回执后最多再试几次（0 = 不重试）
# 命中风控信号（操作频繁一类）或掉登录时一次都不重试，直接交给熔断/判死
TASK_RETRY_TIMES=1

# 可选：日志级别
# 可选值：Debug / Info / Warning / Error（大小写不敏感，但建议与 GUI 下拉框一致写 Debug）
LOG_LEVEL=Info

# ===== 融合版新增：空跑（dry-run）=====
#
# 可选：空跑档位。off=正常发送；select=只跑"选中"这一步（不输入、不发送）；
#       full=真把消息输入进编辑器并读回校验，然后清空，不点发送。
# 别写错值：认不出来的值会**回落到 off（真发）**，不会悄悄变成空跑。
# 命令行/网页面板传的档位优先于这里。
DRY_RUN=off

# 可选：目标之间的额外间隔（秒，浮点）。这是对 cloakbrowser 自带拟人节奏的**兜底**，
# 设 0/0 表示完全保持原节奏、不额外等待。空跑时不会等待。
SEND_INTERVAL_MIN_SECONDS=8
SEND_INTERVAL_MAX_SECONDS=20

# ===== 融合版新增：发送节奏（2026-10-24，见 FUSION-DESIGN.md §13）=====
#
# 可选：定时器到点后先随机等 0~N 秒再开浏览器。门铃每 5 分钟整分敲一次，不磨一下
# 的话"每天开始发送"的时刻永远是 :00/:05/:10。只对定时触发生效，面板/命令行立即运行
# 与空跑都不等。0 = 准点开跑。
RUN_START_JITTER_SECONDS=90

# 可选：长尾停顿。约 15% 的概率在正常间隔之外再多停 0~N 秒，让"下一条等多久"不是
# 整齐的均匀分布。0 = 关闭（回到纯均匀）。
SEND_INTERVAL_LONG_PAUSE_SECONDS=75

# 可选：暖场浏览。门禁通过后先在会话列表里滚 N 秒再发（只滚不点、失败不影响发送）。
# 0 = 关闭（默认）；上限 120。
WARMUP_BROWSE_SECONDS=0

# 可选：分段输入。一条消息按 N 个字切块打进去，块间停 M 毫秒（80~200ms 之间抖动）。
# 任一为 0 表示一次性打完整段（老行为）。
TYPING_CHUNK_CHARS=6
TYPING_CHUNK_DELAY_MS=110
# ===== 融合版新增：限流熔断 =====
#
# 可选：是否启用限流熔断（命中风控文案/回执即中止本轮剩余目标）
LIMIT_GUARD_ENABLED=true

# 可选：熔断后的冷却时长（分钟）。冷却期内定时任务与手动触发都会跳过整轮。
LIMIT_COOLDOWN_MINUTES=30

# 可选：禁跑时间窗（"HH:MM-HH:MM"，跨零点写法也认）。
# 这段**绝对不发**。它的用途是"两个程序别抢同一个抖音账号"：同一个人用同一个账号，
# 两个 Chromium 同时登录会互踢掉线、也更容易被风控盯上。
# ⚠️ 默认 off —— 2026-10-01 起部署机上只剩这一套在发（旧部署 douyin-spark.service
# 已停用禁用），窗口没必要；而且窗口盖住定时器时间会让那一轮**整轮跳过、一条都不发**，
# 面板会画一个红框提前告诉你。真要设（比如夜里不想发）就写 "22:30-07:30" 这种。
# 临时放行一轮用 QUIET_WINDOW_OVERRIDE=1。
QUIET_WINDOW=off
QUIET_WINDOW_OVERRIDE=

# ===== 融合版新增：结果通知（2026-10-24，见 core/notify.py）=====
#
# 可选：一轮真发结束后把结论推到手机/IM。留空 = 不通知。
# 按主机名自动挑 JSON 形状（填完整地址，路径里的 token 别漏）：
#   https://sctapi.ftqq.com/SCTxxxx.send                        Server酱
#   https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...    企业微信群机器人
#   https://oapi.dingtalk.com/robot/send?access_token=...       钉钉机器人（关键词/加签先在钉钉后台配好）
#   https://open.feishu.cn/open-apis/bot/v2/hook/...            飞书自定义机器人
#   https://api.telegram.org/bot<token>/sendMessage?chat_id=... Telegram
#   其它地址按通用 JSON 发：{"title","text","status","run_id","at","accounts"}（给自建网关用）
# ⚠️ 地址里带的就是凭据（token）。面板上会打码显示，日志里只打主机名。
# 配好之后可以在面板「运行配置」里点「发送测试通知」，或跑 python main.py notify-test。
NOTIFY_WEBHOOK_URL=

# 可选：off=不通知；error=只在有账号没发成、或命中风控熔断时推（默认）；always=每轮真发都推。
# 空跑（dry-run）永远不推。认不出来的值按 error 处理（宁可按响一次，也不能静默不发）。
NOTIFY_LEVEL=error

# 可选：单次推送超时（秒，3~60）。推送在放锁之后做，最坏等于把这一轮拖慢这么久。
NOTIFY_TIMEOUT_SECONDS=10

# 可选：运行账本/运行锁/冷却状态文件位置（相对路径按仓库根解析）
RUN_LEDGER_FILE=logs/runs.jsonl
RUN_LOCK_FILE=logs/run.lock
RATE_LIMIT_FILE=logs/rate_limit.json

# 注意：**没有** RUN_SOURCE。它标记"这一轮是谁触发的"，面板的"触发来源"列读它。
# 命令行走 main.py 时默认 cli，面板"立即运行"自己传 webui，
# 定时器由 deploy/douyin-spark-fusion-daily.service 里的
# Environment=RUN_SOURCE=timer 注入。写进这里会让三个入口全都变成同一个来源。

# ===== 融合版新增：web 仪表盘（webui/，见 docs/webui.md）=====
#
# 可选：监听地址与端口。绑非回环地址（如 0.0.0.0）时**必须**配置口令，否则拒绝启动。
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8787

# 二选一：明文口令（简单）或口令哈希（推荐，用 python -m webui.hash_password 生成）
# 这两个键也是**面板自己的登录口令**：登录后在首页「访问口令」里可以直接改，
# 改完两个键会被一起写（不用的那个清成空行），所有旧会话立刻失效。
WEBUI_PASSWORD=
WEBUI_PASSWORD_HASH=

# 可选：会话 cookie 的**签名密钥**（不是登录口令！登录框只认上面那两个键）。
# 留空则每次启动随机生成 —— 重启后所有人要重新登录。
WEBUI_SESSION_SECRET=

# 可选：登录保持时长（秒），默认 30 天 = 2592000；上限 400 天（浏览器对 cookie 有效期的硬上限，
# 写更大也会被截断）。它是**读的时候**才生效：调大后已经登录的浏览器立刻受益，调小会把超过
# 新时长的会话立刻踢下线；改口令永远会作废所有会话。
WEBUI_SESSION_MAX_AGE=2592000

# 可选：面板"立即运行"打开时默认选中的档位：off（真实发送）/ select（只选中不发送）/
# full（输入后清空）。留空或写别的值都回落到 off。**只是默认选中**，
# 每次点按钮前仍然可以在面板上改档位，服务端按提交上来的值执行。
WEBUI_DEFAULT_DRY_RUN=off

# 可选：扫码登录用到的浏览器资料目录（默认 logs/login-profile）。
# 里面存着扫码时那份浏览器配置 —— 同一个账号再次打开会直接复用登录态，
# 所以它等价于凭据，别提交、别共享。
LOGIN_PROFILE_DIR=logs/login-profile

# 可选：每个账号的浏览器状态快照目录（默认 logs/browser-state）。
# 发送时会把它挂到浏览器上，让每一轮都还是同一台设备（设备号、localStorage、
# 服务端后来签发的 cookie）—— 否则每轮都是新设备，抖音会把会话当异常，
# 登录态明显短命。它和 .env 里的 COOKIES_<抖音号> 一样等价于凭据（0600/0700），
# 别提交、别进备份。删掉不炸，只是下次会以新设备身份重新登录一次。
BROWSER_STATE_DIR=logs/browser-state
# 浏览器语言与时区：要和"出口 IP 所在的城市"对得上。UA 自称 Windows、时区却
# 和出口 IP 不在同一地（本机系统时区 Asia/Shanghai、出口在香港 HGC 住宅宽带），
# 是风控里最便宜的一条对照。换代理、搬家、出口 IP 变了以后记得一起改。
# 时区留空 = 跟服务器系统时区走；语言留空 = zh-CN。例：出口在香港就填
# BROWSER_TIMEZONE=Asia/Hong_Kong。注意 TZ 是「定时任务用哪个时区」，两码事。
BROWSER_TIMEZONE=
BROWSER_LOCALE=zh-CN

# 可选：扫码登录二维码的有效期（秒），默认 300。超时后二维码作废，需要重新开始一次。
QR_LOGIN_TTL_SECONDS=300

# 可选：面板"读取好友列表"单次扫描的超时（秒），默认 300。
# 这一步是拿该账号的持久化 profile 起一个无头浏览器，从头滚到会话列表底部 ——
# 几百个会话通常 1~3 分钟，慢的（或节点慢）可能更久。超时会标成"读取失败"，
# 结果里已经读到的部分仍然可用（可以再点一次补齐）。
FRIEND_SCAN_TIMEOUT_SECONDS=300

# 可选：**没在 TASKS 里单独写 time 的账号**每天几点发。
# TASKS 里每个账号可以带自己的 "time": "HH:MM"（面板上就是那张卡的"发送时间"框），
# 写了就用它、没写就落回这里。多个时间用逗号分隔，只取第一个当默认。
#
# ⚠️ 这里**不再需要**和 deploy/douyin-spark-fusion-daily.timer 的 OnCalendar 一致：
#    定时器现在每 5 分钟敲一次门（OnCalendar=*:0/5），"几点发"完全由应用按
#    每个账号自己的时间点判定（core/schedule.py）。
TASK_SCHEDULE_TIMES=20:30

# 可选：到点那一刻的抖动范围（分钟），默认 15。0 = 严格按点发送。
# 具体的偏移量按 sha256(抖音号|日期) 算，**同一个账号同一天恒定一个时刻** ——
# 不能每次触发都重算，否则到点时间一直往后飘、当天永远等不到。
# 面板「设置」页可以直接改这一项。
SCHEDULE_JITTER_MINUTES=15

# 可选：发送时间表的账本（记"今天这个账号发过了没有"），默认 logs/schedule_state.json。
# 只要这一轮真的走到了某个账号就记一笔（成功、失败、账号级报错都算），当天不再重发 ——
# 否则一个 cookie 失效的账号会被每 5 分钟一次的门铃一天踹起来 288 次。
# 文件丢了/读坏了不会致命：后果是当天可能重复发一次。
SCHEDULE_STATE_FILE=logs/schedule_state.json

# 可选：`skipped`（当天一条都没发出去、名额还在）的账号最多被门铃重试几次，默认 6。
# skipped 的含义就是"下一次门铃再试"，而门铃每 5 分钟响一次 —— 一个一直过不了门禁的
# 账号会被反复踹起来开浏览器（一天最多 288 次），这本身就在喂风控。试满 6 次（默认
# 约半小时）就当"今天不再试"：记录留着、状态仍是 skipped，用户重新扫码会把计数
# 归零、当天照样补发。0 = 不限制（退回从前的"一直重试"）。
SCHEDULE_SKIP_RETRY_MAX=6

# 可选：定时器轮次顺带做磁盘维护的间隔（小时），默认 168（一周）；0 = 关闭。
# 缓存只涨不落（实测约 180 MB/天/账号），磁盘满 = 发送直接失败，所以默认每周
# 顺手清一次：只删**在册账号**的可再生缓存 + **过 7 天宽限期**的孤儿资料目录
# （三条安全线见 core/maintenance.py）。间隔到了才动手，没到就是读一次状态文件。
# 失败（例如账号名单读不到）不会推进计时，但至少隔 1 小时才重试，不会刷日志。
MAINTENANCE_AUTO_PRUNE_HOURS=168

# 可选：web 服务"日志"页读取的文件（默认 logs/task.log）。
# systemd 部署时，web 服务与每日任务**两个 unit 的标准输出都追加到同一个文件**
# （deploy/*.service 里写死 logs/douyin-spark-fusion.log），面板因此既能看到
# 每天定时发送的日志，也能看到手动触发与 web 服务自身的日志。
OPS_LOG_FILE=logs/douyin-spark-fusion.log

# 必填：任务列表，JSON 数组。
# 每个账号可带 "message"（专属发送内容，留空 = 用 MESSAGE_TEMPLATE）与
# "time"（专属发送时间 HH:MM，留空 = 用 TASK_SCHEDULE_TIMES）。
# 字段说明：
# - username: 仅用于日志标识，可自定义
# - unique_id: 抖音号，必填
# - fingerprint: 浏览器指纹种子，可选；填了就锁定该账号的指纹，每次启动都用同一个
#                （不填则由 cloakbrowser 每次随机，指纹一变账号容易触发风控）
# - targets: 要续火花的目标列表，至少填写一个
TASKS=[{"username":"账号1","unique_id":"12345678905","fingerprint":"17022","targets":["好友A","好友B"]}]

# 必填：账号 Cookies，JSON 数组
# 变量名格式：COOKIES_<unique_id>
# 下面这个示例对应上方 TASKS 中的 unique_id=12345678905
#
# 说明：
# - 这里必须是浏览器导出的 Cookie JSON 数组
# - 不能直接填 "name=value; name2=value2" 这种原始 cookie 字符串
# - 至少要包含你实际登录后需要的 cookie 项
COOKIES_12345678905=[{"name":"sessionid","value":"your-sessionid","domain":".douyin.com","path":"/"},{"name":"ttwid","value":"your-ttwid","domain":".douyin.com","path":"/"}]

# 多账号示例：
# TASKS=[{"username":"账号1","unique_id":"12345678905","targets":["好友A"]},{"username":"账号2","unique_id":"dy_test_02","targets":["好友B","好友C"]}]
# COOKIES_12345678905=[{"name":"sessionid","value":"xxx","domain":".douyin.com","path":"/"}]
# COOKIES_DY_TEST_02=[{"name":"sessionid","value":"yyy","domain":".douyin.com","path":"/"}]

# 当前代码不会实际使用 OpenAI 生成功能，下面变量不是必填项。
# OPENAI_API_KEY=
